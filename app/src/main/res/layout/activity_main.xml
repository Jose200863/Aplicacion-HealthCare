<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco_fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="20dp"
                android:paddingBottom="94dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvSaludo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/saludo_inicio"
                            android:textColor="@color/gris_secundario"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tvUsuario"
                            style="@style/TituloPantalla"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/nombre_usuario" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:background="@drawable/bg_icono_menta"
                        android:contentDescription="@string/logo_healthcare_descripcion"
                        android:padding="11dp"
                        android:src="@drawable/ic_logo_estetoscopio_verde" />

                </LinearLayout>

                <EditText
                    android:id="@+id/etBuscar"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_busqueda"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_buscar"
                    android:drawablePadding="12dp"
                    android:focusable="false"
                    android:hint="@string/buscar_medicos"
                    android:inputType="none"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/navy_texto"
                    android:textColorHint="@color/gris_secundario"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="@string/titulo_proxima_cita"
                    android:textColor="@color/navy_texto"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@color/verde_profundo"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/tvProxHora"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/sin_citas_proximas"
                            android:textColor="@color/blanco_tarjeta"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvProxMedico"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="@string/agenda_tu_primera_cita"
                            android:textColor="@color/blanco_tarjeta"
                            android:textSize="14sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnVerDetalle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="@string/detalle_cita"
                            android:textAllCaps="false"
                            android:textColor="@color/verde_profundo"
                            android:visibility="gone"
                            app:backgroundTint="@color/blanco_tarjeta"
                            app:cornerRadius="12dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="@string/titulo_especialidades"
                    android:textColor="@color/navy_texto"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/catMedicina"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="3dp">

                        <ImageView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_icono_menta"
                            android:contentDescription="@string/especialidad_medicina"
                            android:padding="16dp"
                            android:src="@drawable/ic_medicina" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:gravity="center"
                            android:text="@string/especialidad_medicina"
                            android:textColor="@color/navy_texto"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/catCardiologia"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="3dp">

                        <ImageView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_icono_rosa"
                            android:contentDescription="@string/especialidad_cardiologia"
                            android:padding="16dp"
                            android:src="@drawable/ic_cardiologia" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:gravity="center"
                            android:text="@string/especialidad_cardiologia"
                            android:textColor="@color/navy_texto"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/catDermatologia"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="3dp">

                        <ImageView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_icono_crema"
                            android:contentDescription="@string/especialidad_dermatologia"
                            android:padding="16dp"
                            android:src="@drawable/ic_dermatologia" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:gravity="center"
                            android:text="@string/especialidad_dermatologia"
                            android:textColor="@color/navy_texto"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/catOftalmologia"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="3dp">

                        <ImageView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_icono_celeste"
                            android:contentDescription="@string/especialidad_oftalmologia"
                            android:padding="16dp"
                            android:src="@drawable/ic_oftalmologia" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:gravity="center"
                            android:text="@string/especialidad_oftalmologia"
                            android:textColor="@color/navy_texto"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/titulo_recientes"
                        android:textColor="@color/navy_texto"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvVerTodas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="8dp"
                        android:text="@string/ver_todas"
                        android:textColor="@color/verde_salud"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <ListView
                    android:id="@+id/lvRecientes"
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:layout_marginTop="10dp"
                    android:divider="@color/gris_borde"
                    android:dividerHeight="1dp"
                    android:nestedScrollingEnabled="true"
                    android:scrollbars="none" />

                <TextView
                    android:id="@+id/tvSinRecientes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:padding="18dp"
                    android:text="@string/sin_medicos_recientes"
                    android:textColor="@color/gris_secundario"
                    android:textSize="14sp"
                    android:visibility="gone" />

            </LinearLayout>

        </ScrollView>

        <include layout="@layout/layout_barra_inferior" />

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAgendar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="88dp"
        android:contentDescription="@string/agendar_cita"
        android:src="@drawable/ic_mas"
        app:backgroundTint="@color/verde_profundo"
        app:tint="@color/blanco_tarjeta" />

</FrameLayout>