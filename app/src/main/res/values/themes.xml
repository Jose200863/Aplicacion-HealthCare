<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style
        name="Base.Theme.AplicacionHealthCare"
        parent="Theme.Material3.DayNight.NoActionBar">

        <item name="colorPrimary">@color/verde_profundo</item>
        <item name="colorOnPrimary">@color/blanco_tarjeta</item>
        <item name="colorSecondary">@color/verde_salud</item>

        <item name="android:statusBarColor">@color/blanco_fondo</item>
        <item name="android:windowLightStatusBar">true</item>

        <item name="android:navigationBarColor">@color/blanco_tarjeta</item>
        <item name="android:windowLightNavigationBar">true</item>

        <item name="android:windowBackground">@color/blanco_fondo</item>

    </style>

    <style
        name="Theme.AplicacionHealthCare"
        parent="Base.Theme.AplicacionHealthCare" />

    <style
        name="BotonPrimario"
        parent="Widget.MaterialComponents.Button">

        <item name="backgroundTint">@color/verde_profundo</item>
        <item name="android:textColor">@color/blanco_tarjeta</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>

    </style>

    <style
        name="BotonPeligro"
        parent="Widget.MaterialComponents.Button">

        <item name="backgroundTint">@color/rojo_peligro</item>
        <item name="android:textColor">@color/blanco_tarjeta</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>

    </style>

    <style
        name="TituloPantalla"
        parent="TextAppearance.MaterialComponents.Headline6">

        <item name="android:textColor">@color/navy_texto</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>

    </style>

</resources>